#!/usr/bin/env python3
"""
Check that .env is in step with .env.example.

    ./helper/check-env

WHY THIS EXISTS
---------------
docker-compose.yml supplies fallbacks:

    OPENAI_MODEL=${OPENAI_MODEL:-gemini-3.5-flash-lite}

which means a stale .env never produces an error. It quietly runs on the
compose default instead. That is how this repo ended up with a .env that
still explained how to get a GitHub Models token, three weeks after GitHub
Models was switched off - and nothing complained, because the fallback
covered it.

The failure mode matters for the workshop: participants are told to pick a
model by editing .env. If the line is not in their file, there is nothing to
edit, and the instruction reads as broken.

WHAT IT CHECKS
--------------
Names, not values. Your key is your business.

  missing     a variable .env.example sets, but .env does not      -> error
  placeholder a value still identical to the example's dummy       -> error
  unknown     a variable in .env that .env.example does not know   -> warning

Commented-out lines in .env.example are optional by definition, so they are
never required - only recognised, which keeps them out of the unknown list.
"""

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
GREEN, YELLOW, RED, DIM, OFF = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"

ASSIGN = re.compile(r'^\s*(#\s*)?([A-Z][A-Z0-9_]*)\s*=(.*)$')


def parse(path):
    """-> (active {name: value}, commented {name: value})"""
    active, commented = {}, {}
    for line in path.read_text().splitlines():
        m = ASSIGN.match(line)
        if not m:
            continue
        is_comment, name, value = m.group(1), m.group(2), m.group(3).strip()
        (commented if is_comment else active)[name] = value
    return active, commented


def looks_like_placeholder(value):
    v = value.lower()
    return bool(v) and ("your-" in v or v.endswith("-here") or v == "changeme")


def main():
    example = ROOT / ".env.example"
    env = ROOT / ".env"

    if not example.exists():
        print(f"{RED}.env.example is missing - cannot check anything{OFF}")
        return 1

    if not env.exists():
        print(f"{RED}No .env file.{OFF}\n\n    cp .env.example .env\n")
        print("Then put a Gemini key in it: https://aistudio.google.com/apikey")
        return 1

    want, optional = parse(example)
    have, _ = parse(env)

    missing = [k for k in want if k not in have]
    stale = [k for k in have if k in want and looks_like_placeholder(have[k])
             and have[k] == want[k]]
    unknown = [k for k in have if k not in want and k not in optional]

    for name in missing:
        print(f"{RED}missing{OFF}      {name}"
              f"{DIM}  - compose falls back to its default, so this runs but "
              f"cannot be configured{OFF}")

    for name in stale:
        print(f"{RED}placeholder{OFF}  {name}"
              f"{DIM}  - still the example value, nothing will authenticate{OFF}")

    for name in unknown:
        print(f"{YELLOW}unknown{OFF}      {name}"
              f"{DIM}  - nothing reads this; left over from an older .env?{OFF}")

    if missing or stale:
        print(f"\n{DIM}Compare against the current example:{OFF}\n"
              f"    diff <(grep -o '^[A-Z_]*' .env) <(grep -o '^[A-Z_]*' .env.example)\n")
        return 1

    if unknown:
        print(f"\n{GREEN}.env is usable{OFF} - the entries above are just unused.")
        return 0

    print(f"{GREEN}.env is in step with .env.example{OFF} "
          f"({len(have)} variables set)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
